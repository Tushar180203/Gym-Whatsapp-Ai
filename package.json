{
  "name": "gym-whatsapp-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/integration/vertical-slices",
    "test:postgres": "REQUIRE_POSTGRES_TESTS=1 vitest run tests/postgres",
    "eval": "node -e \"console.log('AI evals are deferred for the deterministic vertical slice')\"",
    "dev": "node --loader ts-node/esm"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
