# Use an unbilled Gemini Developer API free-tier project for development/MVP.
AI_PROVIDER=gemini
AI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
WHATSAPP_APP_SECRET=
# disabled keeps local tests/setup offline; cloud_api enables real conversational transport.
WHATSAPP_PROVIDER=disabled
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Public business destination in E.164 (+countrycode...), used only for verification deep links.
WHATSAPP_BUSINESS_NUMBER=
WHATSAPP_VERIFY_TOKEN=
# Dedicated 32-byte encryption key, encoded as 64 hexadecimal characters; generate securely.
WHATSAPP_RECIPIENT_ENCRYPTION_KEY=
# Set an explicitly supported Meta Graph version when enabling the adapter (e.g. v25.0).
WHATSAPP_GRAPH_API_VERSION=
# Required HTTPS canonical origin in production; local example only.
APP_ORIGIN=http://localhost:3000
