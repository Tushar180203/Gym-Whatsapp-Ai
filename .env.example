# Use an unbilled Gemini Developer API free-tier project for development/MVP.
AI_PROVIDER=gemini
AI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
WHATSAPP_APP_SECRET=
# Required HTTPS canonical origin in production; local example only.
APP_ORIGIN=http://localhost:3000
